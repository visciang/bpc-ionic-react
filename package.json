    "@mui/icons-material": "^5.15.18",
    "@mui/material": "^5.15.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.23.1",
    "use-debounce": "^10.0.6"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64-gnu": "*",
    "@rollup/rollup-linux-arm64-gnu": "*",
